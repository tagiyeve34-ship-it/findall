<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/pn_bg" android:padding="18dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Zonalar" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/pn_text"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Ev, məktəb və digər təhlükəsiz radiusları idarə et" android:textColor="@color/pn_muted"/>
    <Button android:id="@+id/addBtn" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="14dp" android:background="@drawable/bg_primary_button" android:text="+ Yeni zona" android:textAllCaps="false" android:textColor="@android:color/white"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp"/>
</LinearLayout>
