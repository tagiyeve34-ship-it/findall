<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/swipe" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/pn_bg">
<androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:paddingBottom="28dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/greeting" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Salam" android:textSize="14sp" android:textColor="@color/pn_muted"/>
            <TextView android:id="@+id/childTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dashboard" android:textStyle="bold" android:textSize="27sp" android:textColor="@color/pn_text"/>
        </LinearLayout>
        <TextView android:id="@+id/statusChip" android:layout_width="wrap_content" android:layout_height="38dp" android:gravity="center" android:paddingHorizontal="14dp" android:background="@drawable/bg_teal_soft" android:text="● Online" android:textColor="@color/pn_green" android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="112dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_primary_soft">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BU GÜN" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/pn_primary"/>
            <TextView android:id="@+id/kmValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="0.0 km" android:textSize="25sp" android:textStyle="bold" android:textColor="@color/pn_text"/>
            <TextView android:id="@+id/kmCompare" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dünənlə müqayisə" android:textSize="12sp" android:textColor="@color/pn_muted"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="112dp" android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_teal_soft">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HƏRƏKƏT" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/pn_teal"/>
            <TextView android:id="@+id/movingValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="0 dəq" android:textSize="25sp" android:textStyle="bold" android:textColor="@color/pn_text"/>
            <TextView android:id="@+id/speedValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Orta 0 km/s" android:textSize="12sp" android:textColor="@color/pn_muted"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="105dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_orange_soft">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DAYANACAQ" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/pn_orange"/>
            <TextView android:id="@+id/stopsValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="0" android:textSize="25sp" android:textStyle="bold" android:textColor="@color/pn_text"/>
            <TextView android:id="@+id/stoppedTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 dəq" android:textSize="12sp" android:textColor="@color/pn_muted"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="105dp" android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_purple_soft">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BATAREYA" android:textSize="11sp" android:textStyle="bold" android:textColor="@color/pn_purple"/>
            <TextView android:id="@+id/batteryValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="—%" android:textSize="25sp" android:textStyle="bold" android:textColor="@color/pn_text"/>
            <TextView android:id="@+id/batterySpent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sərfiyyat —" android:textSize="12sp" android:textColor="@color/pn_muted"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_card">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✦ Ağıllı analiz" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/pn_text"/>
        <TextView android:id="@+id/aiInsight" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Məlumatlar analiz olunur…" android:textSize="14sp" android:textColor="@color/pn_muted" android:lineSpacingExtra="3dp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_card">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Batareya analizi" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/pn_text"/>
            <TextView android:id="@+id/batteryNow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—%" android:textStyle="bold" android:textColor="@color/pn_purple"/>
        </LinearLayout>
        <TextView android:id="@+id/batteryFast" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Ən sürətli azalma: —" android:textColor="@color/pn_text"/>
        <TextView android:id="@+id/batteryCharge" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Şarj: —" android:textColor="@color/pn_muted"/>
        <TextView android:id="@+id/batteryRisk" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Analiz: —" android:textStyle="bold" android:textColor="@color/pn_orange"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_card">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Zənglər — bu gün" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/pn_text"/>
            <TextView android:id="@+id/callTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 zəng" android:textColor="@color/pn_primary" android:textStyle="bold"/>
        </LinearLayout>
        <TextView android:id="@+id/callSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Gələn 0 · Gedən 0 · Cavabsız 0" android:textColor="@color/pn_muted"/>
        <TextView android:id="@+id/topContact" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Ən çox danışılan: —" android:textColor="@color/pn_text" android:textStyle="bold"/>
        <TextView android:id="@+id/recentCalls" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Son zənglər görünəcək" android:textColor="@color/pn_muted" android:lineSpacingExtra="5dp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" android:padding="18dp" android:background="@drawable/bg_card">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bugünkü dayanacaqlar" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/pn_text"/>
        <TextView android:id="@+id/stopsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Dayanacaq tapılmayıb" android:textColor="@color/pn_muted" android:lineSpacingExtra="6dp"/>
    </LinearLayout>

    <TextView android:id="@+id/updatedAt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="Yenilənir…" android:textColor="#9AA5B4" android:textSize="12sp"/>
</LinearLayout>
</androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
