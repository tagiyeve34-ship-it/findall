<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:background="@drawable/bg_card" android:padding="16dp" android:gravity="center_vertical">
    <TextView android:id="@+id/icon" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:background="@drawable/bg_primary_soft" android:text="☎" android:textColor="@color/pn_primary" android:textSize="18sp"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="@color/pn_text" android:textSize="15sp"/>
        <TextView android:id="@+id/meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/pn_muted" android:textSize="12sp"/>
    </LinearLayout>
    <TextView android:id="@+id/duration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="@color/pn_text"/>
</LinearLayout>
